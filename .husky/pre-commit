#!/bin/sh
# Pre-commit hook: Run local migrations before committing

echo "🔍 Checking for new migrations..."

# Get list of staged migration files
STAGED_MIGRATIONS=$(git diff --cached --name-only | grep "^migrations/.*\.sql$" || true)

if [ -n "$STAGED_MIGRATIONS" ]; then
    echo "📁 Found staged migrations:"
    echo "$STAGED_MIGRATIONS"
    echo ""
    echo "🔄 Running migrations against LOCAL database..."
    echo "   (Production migrations must be run separately!)"
    echo ""
    
    echo "⚠️  Migration files changed. After pushing, run against each environment:"
    echo "   node scripts/migrate-production.mjs"
else
    echo "✓ No new migrations to run"
fi

exit 0
